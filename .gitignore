# 개인 입력, 다운로드한 모델, 실행별 계획·기록·생성 이미지
/inputs/
/models/
/runs/

# 배포 예제에는 워크북과 거기서 참조하는 PNG만 포함한다.
/examples/living-room/*
!/examples/living-room/scenarios.xlsx
!/examples/living-room/guides/
/examples/living-room/guides/*
!/examples/living-room/guides/living01.png
!/examples/living-room/guides/living01_cable_behind.png
!/examples/living-room/refs/
/examples/living-room/refs/*
!/examples/living-room/refs/black_cable.png
!/examples/living-room/refs/evening_room.png
~$*.xlsx

# Python 가상환경과 빌드·테스트 캐시
/.venv/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.ruff_cache/

# 로컬 환경 변수와 공유용 설정 예시
.env
.env.*
!.env.example
